# ===== Banco / Redis =====
DATABASE_URL=postgresql://sm:sm@postgres:5432/sm
REDIS_URL=redis://redis:6379

# ===== Auth / Cripto (gerar: openssl rand -hex 32) =====
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_ENCRYPTION_KEY=

# ===== Serviço de IA =====
AI_SERVICE_URL=http://ai:8100
AI_SERVICE_TOKEN=
AI_PROVIDER=mock            # mock | openai | anthropic | google
# Opcionais: se vazios/ausentes, usam AI_PROVIDER. Nao fixam OpenAI ou Claude na arquitetura.
# AI_PRIMARY_PROVIDER=anthropic
# AI_AUXILIARY_PROVIDER=openai
# AI_REVIEW_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=google
AI_REPLY_DEBOUNCE_MS=3500   # agrupa mensagens fragmentadas; 0 desativa
# Rotas conversacionais explicitamente homologadas para o piloto. Por padrão,
# apenas suporte; inclua sales somente após validar o fluxo comercial.
PILOT_ROUTE_KEYS=technical_support
# Link oficial IXC V3, sem dados do cliente. Deixe vazio até a origem factual
# de cobertura estar homologada.
IXC_INMAP_AUTO_VIABILITY_PUBLIC_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=512
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_PROMPT_CACHE_ENABLED=true
ANTHROPIC_PROMPT_CACHE_TTL=5m
AI_MONTHLY_ATTENTION_BUDGET_BRL=2500
AI_BUDGET_RECIPIENT_EMAIL=
# Cotação conservadora e ajustável; a fatura dos provedores é a referência final.
AI_USD_TO_BRL=6.0

# ===== Meta (WhatsApp Cloud API / Instagram) =====
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ===== URLs =====
PUBLIC_URL=https://chat.srv1450678.hstgr.cloud
IXC_ALLOWED_HOSTS=ixc.seegfibras.com.br
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# ===== Mídia inbound re-hospedada (opcional) =====
# Diretório dos arquivos baixados da Meta (default ./storage/media).
# No docker-compose o service api já define /data/media (volume media_data).
# MEDIA_DIR=/data/media

# ===== Upload de mídia outbound (Wave C, CONTRACTS §13, opcional) =====
# Cota diária de uploads outbound por org — defesa contra esgotamento de disco
# do volume media_data (compartilhado entre todas as orgs). Default: 300.
# UPLOAD_DAILY_QUOTA_PER_ORG=300

# ===== Observabilidade (Wave C) =====
# GET /api/metrics exige header X-Metrics-Token igual a este valor.
# Obrigatório em produção (gerar: openssl rand -hex 32); opcional em dev —
# sem ela o endpoint fica sempre 401 (não fica público por omissão).
METRICS_TOKEN=
# Rastreamento de erros (Sentry) — opcional. Vazio = SDK nem é carregado.
# Usada tanto pela api quanto pelo serviço de ia (ver infra/docker-compose.yml).
SENTRY_DSN=
OPERATIONS_TEAMS_WEBHOOK_URL=
OPERATIONS_TEAMS_ALERTS_ENABLED=false

# ===== Postgres (container) =====
POSTGRES_USER=sm
POSTGRES_PASSWORD=sm
POSTGRES_DB=sm
