# ===== Banco / Redis =====
DATABASE_URL=postgresql://sm:sm@postgres:5432/sm
REDIS_URL=redis://redis:6379

# ===== Auth / Cripto (gerar: openssl rand -hex 32) =====
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_ENCRYPTION_KEY=

# ===== Serviço de IA =====
AI_SERVICE_URL=http://ai:8100
AI_SERVICE_TOKEN=
AI_PROVIDER=mock            # mock | openai | anthropic | google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ===== Meta (WhatsApp Cloud API / Instagram) =====
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ===== URLs =====
PUBLIC_URL=https://chat.srv1450678.hstgr.cloud
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# ===== Mídia inbound re-hospedada (opcional) =====
# Diretório dos arquivos baixados da Meta (default ./storage/media).
# No docker-compose o service api já define /data/media (volume media_data).
# MEDIA_DIR=/data/media

# ===== Upload de mídia outbound (Wave C, CONTRACTS §13, opcional) =====
# Cota diária de uploads outbound por org — defesa contra esgotamento de disco
# do volume media_data (compartilhado entre todas as orgs). Default: 300.
# UPLOAD_DAILY_QUOTA_PER_ORG=300

# ===== Observabilidade (Wave C) =====
# GET /api/metrics exige header X-Metrics-Token igual a este valor.
# Obrigatório em produção (gerar: openssl rand -hex 32); opcional em dev —
# sem ela o endpoint fica sempre 401 (não fica público por omissão).
METRICS_TOKEN=
# Rastreamento de erros (Sentry) — opcional. Vazio = SDK nem é carregado.
# Usada tanto pela api quanto pelo serviço de ia (ver infra/docker-compose.yml).
SENTRY_DSN=

# ===== Postgres (container) =====
POSTGRES_USER=sm
POSTGRES_PASSWORD=sm
POSTGRES_DB=sm
