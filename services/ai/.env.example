# services/ai — variaveis de ambiente (exemplo; NUNCA commitar .env real)
# psycopg aceita a mesma URL usada pelo Prisma (schema= e params extras sao normalizados)
DATABASE_URL=postgresql://sm:sm@localhost:5432/sm
AI_SERVICE_TOKEN=change-me
# Lista fechada de setores permitidos no piloto. O default do serviço é apenas
# technical_support; o compose precisa repassar esta variável explicitamente.
PILOT_ROUTE_KEYS=technical_support
# Link HTTPS da V3 com campaignId e channelId. Vazio preserva a orientação
# factual sem redirecionar a pessoa para o formulário.
IXC_INMAP_AUTO_VIABILITY_PUBLIC_URL=
# mock | openai | anthropic | google
AI_PROVIDER=mock
# AI_PRIMARY_PROVIDER=openai
# AI_REVIEW_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Rastreamento de erros (Sentry, CONTRACTS §14) — opcional. Vazio = SDK nem é
# importado. Mesma env var do serviço api (SENTRY_DSN); passada separadamente
# para o container ai em infra/docker-compose.yml (whitelist de env vars).
SENTRY_DSN=
